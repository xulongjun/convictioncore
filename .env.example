# Copy to .env (gitignored) for docker compose / local overrides.
MSSQL_SA_PASSWORD=Your_password123
MSSQL_PORT=1433

# Prefer user secrets for the API; env works too:
#   dotnet user-secrets set "ConnectionStrings:ConvictionCore" "..." --project src/ConvictionCore.Api
#   export ConnectionStrings__ConvictionCore="..."
ConnectionStrings__ConvictionCore=Server=localhost,1433;Database=ConvictionCore;User Id=sa;Password=Your_password123;TrustServerCertificate=True;Encrypt=True

# Development-only identity (must be empty outside Development)
DeveloperIdentity__PrincipalId=local-dev
